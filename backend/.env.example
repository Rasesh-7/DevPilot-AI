# DevPilot AI Backend — Environment Variables
# Copy this file to .env and fill in your values.

# Google Gemini API key (optional — without it, the app runs in demo mode with mock data)
GEMINI_API_KEY=

# GitHub personal access token (optional — increases rate limit from 60 to 5000 req/h)
GITHUB_TOKEN=

# Allowed origins for CORS (comma-separated, default: http://localhost:3000,http://127.0.0.1:3000)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
